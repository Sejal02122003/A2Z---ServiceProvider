<!-- ================================================================= -->
<!-- A2Z SERVICE PROVIDER - ANDROID MANIFEST CONFIGURATION SNIPPET   -->
<!-- Copy these tags into your Android project's AndroidManifest.xml -->
<!-- ================================================================= -->

<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.a2z.serviceprovider">

    <!-- 1. REQUIRED PERMISSIONS FOR CLOSED-APP RINGING & CALL POPUP -->
    
    <!-- Required on Android 13+ (API level 33+) to display any notifications -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Required for high-priority siren vibration patterns -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Required to wake up the CPU/screen when a new booking arrives while device is locked/asleep -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Required to display heads-up full-screen incoming call UI over the lock screen -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />

    <!-- Required for background processing and continuous ringtone management -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="A2Z Service Provider"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.AppCompat.Light.NoActionBar">

        <!-- 2. FIREBASE CLOUD MESSAGING SERVICE (LISTENS WHEN APP IS CLOSED) -->
        <service
            android:name=".MyFirebaseMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- 3. DISMISS RECEIVER TO SILENCE CONTINUOUS SIREN WHEN USER TAPS 'DISMISS' -->
        <receiver
            android:name=".DismissReceiver"
            android:exported="false" />

        <!-- 4. DEFAULT NOTIFICATION CHANNEL METADATA -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="new_booking_alerts_v2" />

        <!-- 5. DEFAULT NOTIFICATION ICON -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@mipmap/ic_launcher" />

    </application>

</manifest>
